{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sippycup.dev/schemas/scope-v1.schema.json",
  "title": "Sippycup scope intake v1",
  "description": "Structural schema. `scope check` additionally enforces cross-field consistency (addresses inside approved networks, ports and transports approved, TLS server names, validity window against the clock, ceilings that can hold one call) and rejects any field or value that looks like a password, token, or key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name"],
  "properties": {
    "schema_version": {"const": "sippycup.dev/scope/v1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pending", "approved", "revoked"]},
        "approval_id": {"type": ["string", "null"], "maxLength": 128},
        "approved_by": {"type": ["string", "null"], "maxLength": 128},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "signaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "transports": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["udp", "tcp", "tls"]}
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "address", "transport", "port"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$"},
          "address": {"type": "string"},
          "transport": {"enum": ["udp", "tcp", "tls"]},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "tls_server_name": {"type": ["string", "null"]},
          "tls_ca_file": {"type": ["string", "null"], "pattern": "^work/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"}
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "port_range": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
            "end": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535}
          }
        },
        "protection": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["rtp", "sdes-srtp", "dtls-srtp"]}
        },
        "codecs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["PCMU", "PCMA", "G722", "OPUS"]}
        },
        "dtmf": {"enum": ["rfc4733", "sip-info", "inband", "none", null]},
        "symmetric_rtp": {"type": ["boolean", "null"]}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_addresses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": ["boolean", "null"]},
        "username": {"type": ["string", "null"]},
        "realm": {"type": ["string", "null"]},
        "credential_ref": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "description": "The opaque NAME of a secret in an external source, never its value."
        },
        "credential_delivery": {
          "enum": ["secret-manager", "encrypted-message", "in-person", "phone-call", "other", null]
        }
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "user", "expect"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "target": {"type": "string"},
          "user": {"type": "string"},
          "expect": {"enum": ["echo", "agent", "reject"]}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls": {"type": ["integer", "null"], "minimum": 1},
        "concurrent_calls": {"type": ["integer", "null"], "minimum": 1},
        "calls_per_second": {"type": ["integer", "null"], "minimum": 1},
        "packets_per_second": {"type": ["integer", "null"], "minimum": 1},
        "packets": {"type": ["integer", "null"], "minimum": 1},
        "bytes": {"type": ["integer", "null"], "minimum": 1},
        "call_duration_seconds": {"type": ["integer", "null"], "minimum": 1},
        "total_duration_seconds": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "stop_conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consecutive_failures": {"type": ["integer", "null"], "minimum": 1},
        "unexpected_response": {"type": ["boolean", "null"]},
        "packet_loss_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      }
    },
    "test_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_classes": {"type": "array", "items": {"type": "string"}},
        "exclusions": {"type": "array", "items": {"type": "string", "maxLength": 200}}
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": ["string", "null"]},
        "channel": {"type": ["string", "null"]},
        "can_stop_test": {"type": ["boolean", "null"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 3650},
        "disclosure": {"enum": ["private", "coordinated", "public-after-remediation", null]}
      }
    },
    "security_checks": {
      "description": "Optional owner-approved posture checks (docs/SECURITY-CHECKS.md); absent approves none.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "approved": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "items": {"enum": ["banner-disclosure", "options-methods", "tls-certificate", "tls-protocols", "cleartext-signaling", "unauthenticated-register", "digest-quality", "unauthenticated-invite", "user-enumeration", "nonce-replay", "srtp-policy"]}
        },
        "max_requests": {"type": ["integer", "null"], "minimum": 1, "maximum": 200}
      }
    },
    "platform": {
      "description": "Optional (question sheet part 2): the whole platform, production safety, third parties, dialing reach, and names versus addresses. Any answer may be the word pending or unknown; both are open and nothing is inferred from them. See docs/SCOPE-INTAKE.md, 'Platform and application answers'.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "components": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "sip_edge": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "media_servers": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "admin_console": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "customer_web_app": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "api": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "websocket_webrtc": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "provisioning": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "voicemail": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "ivr": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "conference": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
            "recording": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]}
          }
        },
        "out_of_scope": {"$ref": "#/$defs/words"},
        "environment": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["production", "staging", "dedicated-test", "pending", "unknown", null]},
            "real_customers": {"$ref": "#/$defs/flag"},
            "test_tenant": {"$ref": "#/$defs/text"},
            "never_touch": {"$ref": "#/$defs/words"}
          }
        },
        "third_parties": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "hosting": {"type": ["object", "null"], "additionalProperties": false, "properties": {"provider": {"$ref": "#/$defs/text"}, "permission": {"enum": ["out-of-path", "permitted", "pending", "unknown", null]}, "reference": {"$ref": "#/$defs/text"}}},
            "cdn_waf": {"type": ["object", "null"], "additionalProperties": false, "properties": {"provider": {"$ref": "#/$defs/text"}, "permission": {"enum": ["out-of-path", "permitted", "pending", "unknown", null]}, "reference": {"$ref": "#/$defs/text"}}},
            "pstn_carrier": {"type": ["object", "null"], "additionalProperties": false, "properties": {"provider": {"$ref": "#/$defs/text"}, "permission": {"enum": ["out-of-path", "permitted", "pending", "unknown", null]}, "reference": {"$ref": "#/$defs/text"}}},
            "sms": {"type": ["object", "null"], "additionalProperties": false, "properties": {"provider": {"$ref": "#/$defs/text"}, "permission": {"enum": ["out-of-path", "permitted", "pending", "unknown", null]}, "reference": {"$ref": "#/$defs/text"}}},
            "email": {"type": ["object", "null"], "additionalProperties": false, "properties": {"provider": {"$ref": "#/$defs/text"}, "permission": {"enum": ["out-of-path", "permitted", "pending", "unknown", null]}, "reference": {"$ref": "#/$defs/text"}}}
          }
        },
        "dialing": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "reach": {"type": ["object", "null"], "additionalProperties": {"enum": ["on-net", "pstn", "pending", "unknown"]}},
            "never_dial": {"$ref": "#/$defs/words"},
            "never_dial_prefixes": {"$ref": "#/$defs/words"},
            "toll": {"enum": ["no-cost", "accepted", "refused", "pending", "unknown", null]}
          }
        },
        "operations": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "allowed_hours": {"$ref": "#/$defs/text"},
            "max_concurrent_calls": {"$ref": "#/$defs/number"},
            "max_requests_per_second": {"$ref": "#/$defs/number"},
            "blocking": {"$ref": "#/$defs/text"},
            "emergency_contact": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {"name": {"$ref": "#/$defs/text"}, "channel": {"$ref": "#/$defs/text"}}
            },
            "stop_signal": {"$ref": "#/$defs/text"}
          }
        },
        "addressing": {
          "description": "Public DNS names are identities only; addresses are the literal IPs the owner gave.",
          "oneOf": [
            {"enum": ["pending", "unknown", null]},
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {"type": "string"},
                  "addresses": {"oneOf": [{"enum": ["pending", "unknown", null]}, {"type": "array", "items": {"type": "string"}}]},
                  "shared": {"$ref": "#/$defs/flag"},
                  "changing": {"$ref": "#/$defs/flag"}
                }
              }
            }
          ]
        }
      }
    },
    "application": {
      "description": "Optional (question sheet part 2): web, API, and WebSocket surfaces, test identities, stored object classes, and the owner's route inventory. A record only: no Sippycup command sends HTTP or WebSocket traffic to these surfaces. Credential references are names, never values.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "surfaces": {
          "oneOf": [
            {"enum": ["pending", "unknown", null]},
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
                  "kind": {"enum": ["browser", "api", "websocket", null]},
                  "status": {"enum": ["in-scope", "out-of-scope", "pending", "unknown", null]},
                  "base_url": {"type": ["string", "null"], "maxLength": 512},
                  "connect_address": {"type": ["string", "null"], "description": "Literal IP address, pending, or unknown. Never a hostname."},
                  "connect_port": {"$ref": "#/$defs/number"},
                  "tls_server_name": {"type": ["string", "null"]},
                  "tls_ca": {"enum": ["public", "private", "pending", "unknown", null]},
                  "tls_ca_file": {"type": ["string", "null"], "pattern": "^work/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"},
                  "allowed_origins": {"$ref": "#/$defs/words"}
                }
              }
            }
          ]
        },
        "identities": {
          "oneOf": [
            {"enum": ["pending", "unknown", null]},
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
                  "role": {"type": ["string", "null"]},
                  "tenant": {"type": ["string", "null"]},
                  "credential_ref": {"type": ["string", "null"], "description": "NAME of the secret (or pending / unknown), never its value."}
                }
              }
            }
          ]
        },
        "object_classes": {"$ref": "#/$defs/words"},
        "route_inventory": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["openapi", "har", "route-list", "none", "pending", "unknown", null]},
            "file": {"type": ["string", "null"], "pattern": "^work/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"}
          }
        }
      }
    }
  },
  "$defs": {
    "text": {"type": ["string", "null"], "description": "Plain text, or the word pending or unknown."},
    "flag": {"description": "true, false, pending, or unknown.", "enum": [true, false, "pending", "unknown", null]},
    "number": {"description": "A whole number, pending, or unknown.", "oneOf": [{"type": "integer", "minimum": 1}, {"enum": ["pending", "unknown", null]}]},
    "words": {"description": "A list of short texts ([none] for none), pending, or unknown.", "oneOf": [{"enum": ["pending", "unknown", null]}, {"type": "array", "uniqueItems": true, "items": {"type": "string"}}]}
  }
}
