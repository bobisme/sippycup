{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sippycup.dev/schemas/call-result-v1.schema.json",
  "title": "Sippycup guided baseline call result",
  "description": "result.json written by `./bin/sippycup call` in every run directory. `--format json` prints the same document plus `evidencePrivacy`; a refused (blocked) call prints only apiVersion, state, verdict, exitCode, blockingErrors, runDirectory=null, and networkActivity=none, and creates no run directory. Values that were not observed are null.",
  "type": "object",
  "required": [
    "apiVersion",
    "state",
    "verdict",
    "exitCode",
    "profile",
    "target",
    "destinationUri",
    "localAddress",
    "networkMode",
    "durationSeconds",
    "captureFilter",
    "preflight",
    "softphone",
    "triage",
    "oracle",
    "recording",
    "notes",
    "timestamps",
    "runDirectory",
    "evidenceManifest",
    "journalCommand",
    "networkActivity"
  ],
  "properties": {
    "apiVersion": {"const": "sippycup.dev/call-result/v1"},
    "state": {"enum": ["completed", "failed", "cancelled", "blocked"]},
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "possible-nat-one-way-media",
        "one-way-media",
        "preflight-failed",
        "registration-failed",
        "call-not-answered",
        "call-not-placed",
        "call-error",
        "media-outside-scope",
        "signaling-outside-scope",
        "capture-failed",
        "capture-died",
        "authorization-lapsed",
        "internal-error",
        "tls-not-verified",
        "tls-name-pinning-failed",
        "call-busy",
        "call-declined",
        "call-auth-failed",
        "call-forbidden",
        "call-not-found",
        "call-unavailable",
        "call-rate-limited",
        "call-media-not-acceptable",
        "call-redirected",
        "call-rejected-4xx",
        "call-rejected-5xx",
        "call-rejected-6xx",
        "peer-hung-up-early",
        "silent-audio",
        "slow-setup",
        "srtp-not-negotiated",
        "dtmf-not-negotiated",
        "dtmf-mismatch",
        "codec-not-offered",
        "cancelled",
        "blocked"
      ]
    },
    "exitCode": {"enum": [0, 1, 2, 130, 143]},
    "profile": {"type": "string"},
    "target": {
      "type": "object",
      "required": ["host", "port", "transport"],
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "transport": {"enum": ["udp", "tcp", "tls"]}
      }
    },
    "destinationUri": {"type": "string", "pattern": "^sip:"},
    "destination": {
      "type": "object",
      "description": "The dialed user part against the profile's target.approved_destinations. approved and onApprovedList are null when the profile carried no list (restricted false): the destination was then not checked.",
      "required": ["dialed", "approved", "restricted", "onApprovedList"],
      "properties": {
        "dialed": {"type": "string"},
        "approved": {"type": ["array", "null"], "items": {"type": "string"}},
        "restricted": {"type": "boolean"},
        "onApprovedList": {"type": ["boolean", "null"]}
      }
    },
    "localAddress": {"type": "string"},
    "natAddresses": {"type": "array", "items": {"type": "string"}, "description": "Optional, behind NAT: where the target saw this call's source (PJSUA's address-change line, which repeats the registrar's Via received/rport). The evidence lint accepts it only as text, never as a packet address."},
    "overlap": {"type": "object", "description": "Optional: the run started beside another run of this checkout (SIPPYCUP_ALLOW_OVERLAP); its verdict is unreliable.", "properties": {"activeRuns": {"type": "array", "items": {"type": "object"}}, "note": {"type": "string"}}},
    "networkMode": {"enum": ["private", "host", "none", "unknown"]},
    "durationSeconds": {
      "type": "object",
      "required": ["requested", "limit", "effective"],
      "properties": {
        "requested": {"type": "integer", "minimum": 1},
        "limit": {"type": ["integer", "null"]},
        "effective": {"type": "integer", "minimum": 1}
      }
    },
    "captureFilter": {"type": "string"},
    "mediaScope": {
      "type": ["object", "null"],
      "description": "The media-scope rules the softphone enforced (literal approved addresses, the profile's media.networks and media.port_range) and which rule admitted the media peer PJSUA reported: admittedBy approved-address, media-network (network names the CIDR; media only, never a signaling target), any-address (only a port rule), or null (refused or peer unknown). inScope is null while the peer is unknown. null when no call object was built.",
      "properties": {
        "rules": {"type": "object"},
        "peer": {"type": ["string", "null"]},
        "admittedBy": {"enum": ["approved-address", "media-network", "any-address", null]},
        "network": {"type": ["string", "null"]},
        "portAdmitted": {"type": ["boolean", "null"]},
        "inScope": {"type": ["boolean", "null"]}
      }
    },
    "preflight": {
      "type": ["object", "null"],
      "properties": {
        "ok": {"type": "boolean"},
        "detail": {"type": ["string", "null"]}
      }
    },
    "softphone": {
      "type": ["object", "null"],
      "description": "Facts PJSUA printed; RTP counts come from PJSUA's own call dump.",
      "properties": {
        "registration_attempted": {"type": "boolean"},
        "registered": {"type": ["boolean", "null"]},
        "registration_status": {"type": ["integer", "null"]},
        "dialed": {"type": "boolean"},
        "answered": {"type": "boolean"},
        "final_status": {"type": ["integer", "null"]},
        "disconnect_status": {"type": ["integer", "null"]},
        "disconnect_reason": {"type": ["string", "null"]},
        "connected_seconds": {"type": ["number", "null"]},
        "rtp_tx_packets": {"type": ["integer", "null"]},
        "rtp_rx_packets": {"type": ["integer", "null"]},
        "codec": {"type": ["string", "null"]},
        "media_direction": {"type": ["string", "null"]},
        "media_peer": {"type": ["string", "null"]},
        "hangup": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]},
        "cancelled": {"type": "boolean"},
        "tls_verified": {"type": ["boolean", "null"]},
        "tls_server_name": {"type": ["string", "null"]},
        "local_rtp_port": {"type": ["integer", "null"], "description": "Local RTP port from the SDP offer PJSUA sent."},
        "setup": {"$ref": "#/$defs/setup"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "srtp": {
      "type": "object",
      "description": "SDES-SRTP requested (mode) and negotiated (active, suite, answerProfile) as PJSUA logged it. media counts RTP headers (cleartext under SRTP) on the negotiated media port when SRTP was active on non-TLS signaling.",
      "required": ["mode", "active"],
      "properties": {
        "mode": {"enum": ["off", "optional", "mandatory"]},
        "keying": {"enum": ["sdes", null]},
        "active": {"type": ["boolean", "null"]},
        "suite": {"type": ["string", "null"]},
        "offerProfile": {"type": ["string", "null"]},
        "answerProfile": {"type": ["string", "null"]},
        "secureSignaling": {"type": "boolean"},
        "warning": {"enum": ["sdes-key-exposed-on-cleartext-signaling", null]},
        "media": {"type": ["object", "null"]}
      }
    },
    "dtmf": {
      "type": ["object", "null"],
      "description": "Requested RFC 4733 digits. sent is the outbound digit sequence decoded from the capture (sentSource capture) or, when the capture cannot show it, what PJSUA logged (sentSource pjsua-log); echoed is the inbound sequence. verified is true only when the captured outbound digits equal requestedDigits.",
      "required": ["requested", "requestedDigits", "method", "status", "sent", "verified"],
      "properties": {
        "requested": {"type": "string"},
        "requestedDigits": {"type": "string"},
        "method": {"const": "rfc4733"},
        "status": {"enum": ["sent", "notNegotiated", "notSent", "incomplete", "mismatch"]},
        "negotiated": {"type": ["boolean", "null"]},
        "payloadTypes": {"type": "array", "items": {"type": "integer"}},
        "sent": {"type": ["string", "null"]},
        "sentSource": {"enum": ["capture", "pjsua-log"]},
        "pjsuaSent": {"type": "string"},
        "pjsuaReceived": {"type": "string"},
        "echoed": {"type": ["string", "null"]},
        "verified": {"type": ["boolean", "null"]},
        "wire": {"type": ["object", "null"]}
      }
    },
    "codec": {
      "type": "object",
      "description": "Codecs requested (exclusive: offered only these, from --codec or the profile's media.codecs), approved by the profile, offered, answered, and negotiated (the answer's first codec). Names are NAME/CLOCKRATE from the SDP. unoffered lists answer codecs that were not in the offer (verdict codec-not-offered). wire proves it from the capture: the SDP offer and answer (sdpSource capture, or pjsua-log under TLS) and RTP packet counts per payload type on the negotiated media port; verified is true only when an exclusive offer listed nothing but the requested codecs and the RTP used only the negotiated payload type, telephone-event, or comfort noise.",
      "required": ["requested", "exclusive", "offered", "answered", "negotiated"],
      "properties": {
        "requested": {"type": "array", "items": {"type": "string"}},
        "exclusive": {"type": "boolean"},
        "approved": {"type": ["array", "null"], "items": {"type": "string"}},
        "offered": {"type": "array", "items": {"type": "string"}},
        "answered": {"type": "array", "items": {"type": "string"}},
        "negotiated": {"type": ["string", "null"]},
        "negotiatedPayloadType": {"type": ["integer", "null"]},
        "negotiatedRequested": {"type": ["boolean", "null"]},
        "offerOnlyRequested": {"type": ["boolean", "null"]},
        "unoffered": {"type": "array", "items": {"type": "string"}},
        "wire": {
          "type": ["object", "null"],
          "properties": {
            "sdpSource": {"enum": ["capture", "pjsua-log"]},
            "offerFormats": {"type": ["array", "null"], "items": {"type": "integer"}},
            "answerFormats": {"type": ["array", "null"], "items": {"type": "integer"}},
            "rtpPayloadTypes": {"type": ["object", "null"]},
            "rtpSource": {"enum": ["capture", null]},
            "mediaUsesNegotiated": {"type": ["boolean", "null"]},
            "verified": {"type": ["boolean", "null"]}
          }
        }
      }
    },
    "warnings": {"type": "array", "items": {"enum": ["sdes-key-exposed-on-cleartext-signaling"]}},
    "tls": {
      "type": "object",
      "description": "TLS calls only. serverName is the reviewed certificate name, or the literal address when its IP SAN was verified; every packet went only to connectsTo. trust is system (the image's bundle) or file (the reviewed caFile, whose SHA-256 is caSha256). The oracle cannot read encrypted signaling, so media is RTP decoded from the capture on the negotiated media port.",
      "required": ["verified", "serverName", "trust", "connectsTo"],
      "properties": {
        "verified": {"type": "boolean"},
        "serverName": {"type": "string"},
        "trust": {"enum": ["system", "file"]},
        "caFile": {"type": ["string", "null"]},
        "caSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "preflightVerified": {"type": "boolean"},
        "softphoneVerified": {"type": ["boolean", "null"]},
        "softphoneDetail": {"type": ["string", "null"]},
        "connectsTo": {"type": "string"},
        "media": {"type": ["object", "null"]}
      }
    },
    "setup": {
      "type": ["object", "null"],
      "description": "Call setup facts: seconds from INVITE to answer on the softphone driver's clock, the 18x statuses PJSUA reported (180 Ringing, 183 Session Progress), and whether a 183 (early media offered) was seen. Early-media RTP is included in the softphone's packet counts. Null when no call was dialed.",
      "properties": {
        "seconds": {"type": ["number", "null"]},
        "provisional": {"type": "array", "items": {"type": "integer"}},
        "earlyMedia": {"type": "boolean"}
      }
    },
    "triage": {"type": ["object", "null"]},
    "oracle": {
      "type": ["object", "null"],
      "properties": {
        "verdict": {"enum": ["pass", "fail", "unknown", null]},
        "exit_code": {"type": "integer"}
      }
    },
    "recording": {"type": ["object", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "timestamps": {
      "type": "object",
      "required": ["started", "finished"],
      "additionalProperties": {"type": ["string", "null"]}
    },
    "runDirectory": {"type": ["string", "null"]},
    "evidenceManifest": {"const": "evidence-manifest.json"},
    "journalCommand": {"type": "array", "items": {"type": "string"}},
    "networkActivity": {"type": "string"},
    "blockingErrors": {"type": "array", "items": {"type": "string"}},
    "evidencePrivacy": {"type": "string"}
  },
  "$defs": {
    "setup": {
      "type": ["object", "null"],
      "description": "Call setup from PJSUA's log timestamps, measured from the first INVITE sent (a digest challenge round trip is included).",
      "properties": {
        "source": {"const": "pjsua-log-timestamps"},
        "inviteToProvisionalSeconds": {"type": ["number", "null"]},
        "provisionalStatus": {"type": ["integer", "null"]},
        "inviteToAnswerSeconds": {"type": ["number", "null"]},
        "answerStatus": {"type": ["integer", "null"]}
      }
    }
  }
}
