#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly project_dir
readonly registry="${SIPPYCUP_COMMAND_REGISTRY:-${project_dir}/config/commands.tsv}"
readonly image="${SIPPYCUP_IMAGE:-localhost/sippycup:latest}"
readonly cli_version="1.0.0"

declare -a command_order=()
declare -A command_mode=()
declare -A command_host_target=()
declare -A command_container_target=()
declare -A command_group=()
declare -A command_activity=()
declare -A command_summary=()

load_registry() {
    local name mode host_target container_target group activity summary extra
    local line_number=0
    if [[ ! -f "${registry}" || -L "${registry}" ]]; then
        printf 'Command registry must be a regular non-symlink file: %s\n' \
            "${registry}" >&2
        exit 2
    fi
    while IFS='|' read -r \
        name mode host_target container_target group activity summary extra
    do
        line_number=$((line_number + 1))
        [[ -z "${name}" || "${name}" == \#* ]] && continue
        if [[ -n "${extra:-}" || -z "${summary}" ]]; then
            printf 'Invalid command registry row %s\n' "${line_number}" >&2
            exit 2
        fi
        if [[ ! "${name}" =~ ^[a-z][a-z0-9-]*$ ]]; then
            printf 'Invalid command name on registry row %s\n' "${line_number}" >&2
            exit 2
        fi
        if [[ -n "${host_target}" && ! "${host_target}" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]]; then
            printf 'Invalid host target for %s\n' "${name}" >&2
            exit 2
        fi
        if [[ -n "${container_target}" \
            && ! "${container_target}" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ \
            && "${container_target}" != /bin/bash ]]
        then
            printf 'Invalid container target for %s\n' "${name}" >&2
            exit 2
        fi
        if [[ -n "${command_mode[${name}]+present}" ]]; then
            printf 'Duplicate command in registry: %s\n' "${name}" >&2
            exit 2
        fi
        case "${mode}" in
            builtin|doctor|workbench|direct|host|container|container-isolated|container-private|container-offline|container-live-mcp) ;;
            *)
                printf 'Invalid mode for %s: %s\n' "${name}" "${mode}" >&2
                exit 2
                ;;
        esac
        case "${activity}" in
            offline|local-network|local-network-admin|network|network-admin) ;;
            *)
                printf 'Invalid activity class for %s: %s\n' \
                    "${name}" "${activity}" >&2
                exit 2
                ;;
        esac
        command_order+=("${name}")
        command_mode["${name}"]="${mode}"
        command_host_target["${name}"]="${host_target}"
        command_container_target["${name}"]="${container_target}"
        command_group["${name}"]="${group}"
        command_activity["${name}"]="${activity}"
        command_summary["${name}"]="${summary}"
    done <"${registry}"
}

json_string() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '"%s"' "${value}"
}

render_commands_json() {
    local separator=""
    local name
    printf '{"apiVersion":"sippycup.dev/commands/v1","commands":['
    for name in "${command_order[@]}"; do
        printf '%s{' "${separator}"
        printf '"name":'; json_string "${name}"; printf ','
        printf '"group":'; json_string "${command_group[${name}]}"; printf ','
        printf '"activity":'; json_string "${command_activity[${name}]}"; printf ','
        printf '"execution":'; json_string "${command_mode[${name}]}"; printf ','
        printf '"summary":'; json_string "${command_summary[${name}]}"
        printf '}'
        separator=","
    done
    printf '],"networkActivity":false}\n'
}

render_commands_human() {
    local current_group=""
    local name
    for name in "${command_order[@]}"; do
        if [[ "${command_group[${name}]}" != "${current_group}" ]]; then
            current_group="${command_group[${name}]}"
            printf '\n%s:\n' "${current_group}"
        fi
        printf '  %-18s %-19s %s\n' \
            "${name}" "[${command_activity[${name}]}]" "${command_summary[${name}]}"
    done
}

render_global_help() {
    cat <<'EOF'
Usage:
  ./bin/sippycup [GLOBAL OPTIONS] COMMAND [ARGUMENTS...]
  ./bin/sippycup [GLOBAL OPTIONS] -- COMMAND [ARGUMENTS...]
  ./bin/sippycup

One entrypoint for Sippycup preparation, execution, analysis, evidence, and
robustness workflows. No arguments preserves the legacy toolbox-shell behavior.

Global options:
  --isolated       Use the container's private network namespace.
  --admin          Add NET_ADMIN. Combine with --isolated whenever possible.
  --practice       Join the running local practice target's loopback-only
                   network namespace (see docs/PRACTICE-TARGET.md).
  -h, --help       Show this network-free command index.
  --version        Show the Sippycup CLI version.

Discovery:
  help [COMMAND]   Show global help or an offline command summary.
  commands         List the public command registry.
  commands --format json

The activity label is a warning about what a command can do, not authorization
to do it. Planning and help remain network-free. Use `-- COMMAND` only as the
advanced escape hatch for arbitrary in-image tools.

Scope: call, matrix, checks and campaign send only under an approved profile
or manifest. preflight and `media send` are bound when given --profile PROFILE
and print a `Scope:` line that says so; SIPPYCUP_REQUIRE_PROFILE=1 makes them
refuse to run without one. shell and `-- COMMAND` are UNBOUND: nothing they
run is checked against an approval. See docs/CLI.md, "Scope binding".
EOF
    render_commands_human
    printf '\nNetwork activity: none\n'
}

render_command_help() {
    local name="$1"
    if [[ -z "${command_mode[${name}]+present}" ]]; then
        unknown_command "${name}"
    fi
    cat <<EOF
Usage: ./bin/sippycup ${name} [ARGUMENTS...]

${command_summary[${name}]}.

Group:              ${command_group[${name}]}
Activity class:     ${command_activity[${name}]}
Execution strategy: ${command_mode[${name}]}

This summary is generated offline. Run \`./bin/sippycup ${name} --help\` for
the backing command's detailed arguments. Reachability never grants target
authorization.

Network activity: none
EOF
}

suggest_command() {
    local unknown="$1"
    shift
    command -v python3 >/dev/null 2>&1 || return 0
    python3 - "${unknown}" "$@" <<'PY'
import difflib
import sys

match = difflib.get_close_matches(sys.argv[1], sys.argv[2:], n=1, cutoff=0.55)
if match:
    print(match[0])
PY
}

unknown_command() {
    local name="$1"
    local suggestion
    suggestion="$(suggest_command "${name}" "${command_order[@]}")"
    printf 'Unknown Sippycup command: %s\n' "${name}" >&2
    if [[ -n "${suggestion}" ]]; then
        printf 'Did you mean: %s?\n' "${suggestion}" >&2
    fi
    printf 'Run ./bin/sippycup --help for the command index.\n' >&2
    exit 2
}

resolve_runtime() {
    "${project_dir}/bin/container-runtime"
}

run_container() {
    local target="$1"
    shift
    set_stop_labels
    local runtime runtime_name
    runtime="$(resolve_runtime)"
    runtime_name="$(basename -- "${runtime}")"

    local -a caps=(--cap-add=NET_RAW --cap-add=NET_BIND_SERVICE)
    local -a devices=()
    local -a network=(--network=host)
    local -a confinement=()
    local mount="${project_dir}/work:/work:Z"

    if (( offline_container != 0 )); then
        network=(--network=none)
        caps=(--cap-drop=ALL)
        confinement=(
            --read-only
            --security-opt=no-new-privileges=true
            --pids-limit=64
            --tmpfs=/tmp:rw,nosuid,nodev,noexec,size=64m
            --env=PYTHONDONTWRITEBYTECODE=1
            --env=SIPPYCUP_MCP_REQUIRE_SANDBOX=1
        )
        mount="${project_dir}/work:/work:ro,Z"
    fi

    if (( isolated != 0 && offline_container == 0 )); then
        network=()
    fi
    # No tool needs the fixed container hostname to resolve: the in-tree
    # OPTIONS client, SIPp, PJSUA, and the capture tools all use addresses.
    if (( practice != 0 && offline_container == 0 )); then
        join_practice_target "${runtime}"
        network=(--network="container:${practice_container}")
    fi
    # The routed rehearsal (docs/PRACTICE-TARGET.md, "Routed rehearsal"):
    # every networked container gets the private network a real engagement
    # uses, plus one pasta mapping of the rehearsal's link-local address to
    # host loopback, where the routed practice target publishes its ports.
    # Nothing runs on the host network, so that address never reaches a
    # real interface.
    local -a routed_environment=()
    if [[ -n "${routed_address}" ]] && (( offline_container == 0 )); then
        network=(--network="pasta:--map-host-loopback,${routed_address}")
        routed_environment=(--env=SIPPYCUP_ROUTED_ADDRESS="${routed_address}")
    fi
    if (( admin != 0 && offline_container == 0 )); then
        caps+=(--cap-add=NET_ADMIN)
    fi
    if (( admin != 0 && isolated != 0 )); then
        caps+=(--cap-add=SYS_ADMIN)
        devices+=(--device=/dev/net/tun)
    fi
    if (( admin != 0 && isolated == 0 )); then
        cat >&2 <<'EOF'
WARNING: --admin grants NET_ADMIN while using the host network namespace.
Any tc/nftables/iptables change can affect the host. Use this only on a
dedicated test VM, and always remove qdiscs and firewall rules afterward.
EOF
    fi
    if [[ "${runtime_name}" == docker && "$(uname -s)" != Linux && ${#network[@]} -gt 0 ]]; then
        cat >&2 <<'EOF'
WARNING: Docker Desktop host networking is version- and configuration-dependent.
If the target or capture path is unreachable, enable host networking in Docker
Desktop or use a Linux Podman/Docker host. Sippycup will not rewrite the target.
EOF
    fi

    # Without --interactive the runtime closes the container's stdin, so a
    # stdio MCP client or any piped input would reach nothing.
    local -a terminal=(--interactive)
    if [[ -t 0 && -t 1 ]]; then
        terminal=(-it)
    fi
    # Tell in-image tools which namespace they run in so they can say so.
    local network_mode=private
    if [[ -n "${routed_address}" ]] && (( offline_container == 0 )); then
        network_mode=private
    elif [[ "${network[*]}" == "--network=host" ]]; then
        network_mode=host
    elif [[ "${network[*]}" == "--network=none" ]]; then
        network_mode=none
    fi
    local -a command=()
    if [[ -n "${target}" ]]; then
        command=("${target}" "$@")
    else
        command=("$@")
    fi
    exec "${runtime}" run \
        --rm \
        "${terminal[@]}" \
        "${network[@]}" \
        "${caps[@]}" \
        "${devices[@]}" \
        "${confinement[@]}" \
        --hostname=sippycup \
        "${stop_labels[@]}" \
        "${claim_label[@]}" \
        --env=SIPPYCUP_NETWORK_MODE="${network_mode}" \
        "${routed_environment[@]}" \
        "${overlap_environment[@]}" \
        "${require_profile_environment[@]}" \
        "${secret_environment[@]}" \
        --volume="${mount}" \
        "${image}" \
        "${command[@]}"
}

# SIPPYCUP_REQUIRE_PROFILE (anything but empty or 0) makes the optionally
# bound senders (preflight, media send) refuse to run without --profile. It
# is forwarded so the in-image commands see it too (docs/CLI.md, Scope binding).
declare -a require_profile_environment=()
case "${SIPPYCUP_REQUIRE_PROFILE:-}" in
    ""|0) ;;
    *) require_profile_environment=(--env=SIPPYCUP_REQUIRE_PROFILE=1) ;;
esac

# `shell` and the `--` escape hatch run arbitrary in-image tools. Nothing
# there is checked against an approval, and this notice does not pretend
# otherwise. It goes to stderr so stdout stays the tool's own output.
unbound_notice() {
    local what="$1" reach="it can send to any address this host can reach"
    if (( practice != 0 )); then
        reach="it runs in the practice target's loopback-only namespace"
    fi
    printf 'Scope: UNBOUND (%s: no approval, window, address or port is checked here; %s). Send only to addresses copied from the approved profile.\n' \
        "${what}" "${reach}" >&2
}

# Forward only the variables a first-party command names with --secret-env
# (NAME or REF=NAME). The name-only --env form makes the runtime copy the
# value from this process, so the value never appears in any argv.
declare -a secret_environment=()
collect_secret_environment() {
    local argument name
    local expect_value=0
    for argument in "$@"; do
        name=""
        if (( expect_value != 0 )); then
            name="${argument}"
            expect_value=0
        elif [[ "${argument}" == --secret-env ]]; then
            expect_value=1
            continue
        elif [[ "${argument}" == --secret-env=* ]]; then
            name="${argument#--secret-env=}"
        else
            continue
        fi
        name="${name#*=}"
        if [[ ! "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            printf 'Invalid --secret-env variable name.\n' >&2
            exit 2
        fi
        secret_environment+=("--env=${name}")
    done
}

# --practice joins the network namespace of the running practice target. Fail
# closed unless that container is running, carries the practice label, and has
# no network other than its private loopback (--network=none).
join_practice_target() {
    local runtime="$1" state running profile network_mode
    practice_container="${SIPPYCUP_PRACTICE_CONTAINER:-sippycup-practice}"
    if [[ ! "${practice_container}" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$ ]]; then
        printf 'Invalid SIPPYCUP_PRACTICE_CONTAINER: %s\n' "${practice_container}" >&2
        exit 2
    fi
    state="$("${runtime}" container inspect \
        --format '{{.State.Running}}|{{index .Config.Labels "dev.sippycup.profile"}}|{{.HostConfig.NetworkMode}}' \
        -- "${practice_container}" 2>/dev/null || true)"
    IFS='|' read -r running profile network_mode <<<"${state}"
    if [[ "${running}" != true || "${profile}" != practice \
        || "${network_mode}" != none ]]
    then
        printf 'The practice target %s is not up.\n' "${practice_container}" >&2
        printf 'Run: ./bin/sippycup practice-target up\n' >&2
        printf 'No container or network activity was started.\n' >&2
        exit 2
    fi
}

# SIPPYCUP_ROUTED_PRACTICE names the routed practice target container that
# tools/routed_rehearsal.py starts. Fail closed unless it is running, carries
# the routed-practice label and a link-local address label, and sits only on
# an --internal network (no route to any real host).
#
# Wave 11, finding 5: the emergency stop and the host-side commands that only
# read (routed_tolerant below) must not be refused because a variable was left
# in the shell after the routed target went away. For those the join is
# attempted the same way; when it fails they run as if the variable were not
# set (no routed address is admitted) and say so. Every other command,
# senders above all, fails closed exactly as before.
routed_address=""
routed_tolerant=0
join_routed_practice() {
    local name="$1" runtime state running profile address networks network internal
    if [[ ! "${name}" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$ ]]; then
        if (( routed_tolerant != 0 )); then
            printf 'Note: SIPPYCUP_ROUTED_PRACTICE is set to an invalid name and is ignored: %s sends nothing to a target. Unset it before any sending command.\n' \
                "${routed_command}" >&2
            return 0
        fi
        printf 'Invalid SIPPYCUP_ROUTED_PRACTICE: %s\n' "${name}" >&2
        exit 2
    fi
    runtime="$(resolve_runtime)"
    state="$("${runtime}" container inspect \
        --format '{{.State.Running}}|{{index .Config.Labels "dev.sippycup.profile"}}|{{index .Config.Labels "dev.sippycup.routed-address"}}|{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' \
        -- "${name}" 2>/dev/null || true)"
    IFS='|' read -r running profile address networks <<<"${state}"
    read -r -a network <<<"${networks}"
    internal=""
    if (( ${#network[@]} == 1 )); then
        internal="$("${runtime}" network inspect --format '{{.Internal}}' -- "${network[0]}" 2>/dev/null || true)"
    fi
    if [[ "${running}" != true || "${profile}" != routed-practice \
        || ! "${address}" =~ ^169\.254\.([0-9]{1,3})\.([0-9]{1,3})$ \
        || "${internal}" != true ]]
    then
        if (( routed_tolerant != 0 )); then
            printf 'Note: SIPPYCUP_ROUTED_PRACTICE is set, but the routed practice target %s is not up. It is ignored: %s sends nothing to a target. Unset it (or run make routed-rehearsal) before any sending command.\n' \
                "${name}" "${routed_command}" >&2
            return 0
        fi
        printf 'The routed practice target %s is not up (SIPPYCUP_ROUTED_PRACTICE is set).\n' "${name}" >&2
        printf 'Run: make routed-rehearsal, or unset SIPPYCUP_ROUTED_PRACTICE.\n' >&2
        printf 'No container or network activity was started.\n' >&2
        exit 2
    fi
    routed_address="${address}"
}

# Finding 6 (wave 10): a sending command refuses to start while another
# sender of this checkout is active, found the way `stop` finds them
# (lib/sippycup_cockpit/overlap.py). SIPPYCUP_ALLOW_OVERLAP=NAME[,NAME]
# names the runs it may knowingly run beside; the run then records the
# overlap (SIPPYCUP_OVERLAP) and its verdict is reported as unreliable.
#
# Wave 11, finding 1: starts closer together than a container start did not
# see each other. The check now also claims the start for this launcher's
# process ($$, which becomes the runtime's when it execs), under a file lock
# that only the check holds; a later start sees the claim until that process
# is gone. The claim id is put on the container as a label so the claim and
# its running container count as one run. No claim back means no start.
declare -a overlap_environment=()
declare -a claim_label=()
refuse_overlap() {
    local record argument output claim
    for argument in "$@"; do
        # A dry run sends nothing, so it never overlaps.
        [[ "${argument}" == --dry-run ]] && return 0
    done
    if ! command -v python3 >/dev/null 2>&1; then
        printf '%s: python3 is needed to check for another active run of this checkout. Nothing was sent.\n' \
            "${command_name}" >&2
        exit 2
    fi
    output="$(PYTHONPATH="${project_dir}/lib" PYTHONDONTWRITEBYTECODE=1 \
        python3 -m sippycup_cockpit.overlap --repo "${project_dir}" --claim-pid "$$" \
        --command "${command_name}${1:+ $1}")" || exit 2
    claim="${output%%$'\n'*}"
    if [[ ! "${claim}" =~ ^claim\ ([0-9a-f]{32})$ ]]; then
        printf '%s: the check for another active run of this checkout did not claim this start. Nothing was sent.\n' \
            "${command_name}" >&2
        exit 2
    fi
    claim_label=("--label=dev.sippycup.claim=${BASH_REMATCH[1]}")
    record=""
    if [[ "${output}" == *$'\n'* ]]; then
        record="${output#*$'\n'}"
    fi
    if [[ -n "${record}" ]]; then
        export SIPPYCUP_OVERLAP="${record}"
        overlap_environment=(--env=SIPPYCUP_OVERLAP="${record}")
    fi
}

# True when this invocation of a `direct` or `container` command sends to a
# target and must run in a private network namespace: `campaign run|execute`
# (it captures, which rootless tcpdump can do only there) and `preflight`
# (same route and source as call). Help is offline. `media send` captures
# nothing and keeps running on the host.
sends_from_private_container() {
    local argument
    for argument in "$@"; do
        [[ "${argument}" == -h || "${argument}" == --help ]] && return 1
    done
    case "${command_name}" in
        campaign) [[ "${1:-}" == run || "${1:-}" == execute ]] ;;
        preflight) (($# > 0)) ;;
        *) return 1 ;;
    esac
}

# Packaged first-party commands see the host work directory as /work. Rewrite
# path-shaped arguments that resolve beneath it so the same `work/...` spelling
# works on the host and with --isolated/--admin. Arguments without a slash
# (subcommands, option names, plain values) are never touched.
translate_work_arguments() {
    translated_arguments=()
    local argument resolved
    local work_root="${project_dir}/work"
    for argument in "$@"; do
        if [[ "${argument}" == */* && "${argument}" != -* && "${argument}" != /work/* ]]; then
            resolved="$(realpath -m -- "${argument}" 2>/dev/null || true)"
            if [[ "${resolved}" == "${work_root}" ]]; then
                argument=/work
            elif [[ "${resolved}" == "${work_root}"/* ]]; then
                argument="/work/${resolved#"${work_root}/"}"
            fi
        fi
        translated_arguments+=("${argument}")
    done
}

run_live_mcp() {
    local trust_root="${SIPPYCUP_MCP_LIVE_TRUST_ROOT:-}"
    local state_root="${SIPPYCUP_MCP_LIVE_STATE_ROOT:-}"
    local client_id="${SIPPYCUP_MCP_LIVE_CLIENT_ID:-}"
    local enable_one_call="${SIPPYCUP_MCP_LIVE_ENABLE_ONE_CALL:-0}"
    if [[ -z "${trust_root}" || -z "${state_root}" || -z "${client_id}" ]]; then
        cat >&2 <<'EOF'
mcp-live requires SIPPYCUP_MCP_LIVE_TRUST_ROOT,
SIPPYCUP_MCP_LIVE_STATE_ROOT, and SIPPYCUP_MCP_LIVE_CLIENT_ID.
See docs/MCP-LIVE.md. No container or network activity was started.
EOF
        exit 2
    fi
    if [[ ! -d "${trust_root}" || -L "${trust_root}" \
        || ! -d "${state_root}" || -L "${state_root}" ]]
    then
        printf 'mcp-live trust and state roots must be real directories.\n' >&2
        exit 2
    fi
    local runtime runtime_name
    runtime="$(resolve_runtime)"
    runtime_name="$(basename -- "${runtime}")"
    local -a identity=()
    if [[ "${runtime_name}" == docker || "${runtime_name}" == nerdctl ]]; then
        identity=(--user="$(id -u):$(id -g)")
    fi
    set_stop_labels
    local -a live_caps=(--cap-drop=ALL)
    if [[ "${enable_one_call}" == 1 ]]; then
        live_caps+=(--cap-add=NET_RAW)
    elif [[ "${enable_one_call}" != 0 ]]; then
        printf 'SIPPYCUP_MCP_LIVE_ENABLE_ONE_CALL must be 0 or 1.\n' >&2
        exit 2
    fi
    # Without --interactive the runtime closes the container's stdin, so a
    # stdio MCP client or any piped input would reach nothing.
    local -a terminal=(--interactive)
    if [[ -t 0 && -t 1 ]]; then
        terminal=(-it)
    fi
    exec "${runtime}" run \
        --rm \
        "${terminal[@]}" \
        "${identity[@]}" \
        --network=bridge \
        "${live_caps[@]}" \
        --read-only \
        --security-opt=no-new-privileges=true \
        --pids-limit=64 \
        --tmpfs=/tmp:rw,nosuid,nodev,noexec,size=64m \
        --hostname=sippycup-live \
        "${stop_labels[@]}" \
        --env=SIPPYCUP_MCP_LIVE_INPUT_ROOT=/live-inputs \
        --env=SIPPYCUP_MCP_LIVE_TRUST_ROOT=/trust \
        --env=SIPPYCUP_MCP_LIVE_STATE_ROOT=/state \
        --env=SIPPYCUP_MCP_LIVE_CLIENT_ID="${client_id}" \
        --env=SIPPYCUP_MCP_LIVE_ENABLE_ONE_CALL="${enable_one_call}" \
        --volume="${project_dir}/work:/live-inputs:ro,Z" \
        --volume="${trust_root}:/trust:ro" \
        --volume="${state_root}:/state:rw" \
        "${image}" \
        sippycup-mcp-live "$@"
}

load_registry

# Every container this launcher starts carries the checkout and the public
# command, so `./bin/sippycup stop` can find exactly this checkout's senders
# and nothing else (docs/COCKPIT.md, Emergency stop).
declare -a stop_labels=()
set_stop_labels() {
    stop_labels=(
        "--label=dev.sippycup.checkout=${project_dir}"
        "--label=dev.sippycup.command=${command_name:-advanced}"
    )
}

isolated=0
admin=0
practice=0
practice_container=""
advanced=0
offline_container=0
while (($# > 0)); do
    case "$1" in
        --isolated)
            isolated=1
            shift
            ;;
        --admin)
            admin=1
            shift
            ;;
        --practice)
            practice=1
            shift
            ;;
        --)
            advanced=1
            shift
            break
            ;;
        -h|--help)
            render_global_help
            exit 0
            ;;
        --version)
            printf 'sippycup %s\n' "${cli_version}"
            exit 0
            ;;
        -*)
            printf 'Unknown global option: %s\n' "$1" >&2
            printf 'Run ./bin/sippycup --help for usage.\n' >&2
            exit 2
            ;;
        *)
            break
            ;;
    esac
done

if (( practice != 0 && (isolated != 0 || admin != 0) )); then
    printf -- '--practice joins the practice target namespace and cannot be combined with --isolated or --admin.\n' >&2
    exit 2
fi

# Only a successful join below may name the routed address: a value from the
# caller's environment never admits a link-local target (sippycup.link_local).
unset SIPPYCUP_ROUTED_ADDRESS
# Only refuse_overlap may hand a run its overlap record.
unset SIPPYCUP_OVERLAP
if [[ -n "${SIPPYCUP_ROUTED_PRACTICE:-}" ]]; then
    routed_command="${1:-}"
    if (( advanced == 0 && isolated == 0 && admin == 0 && practice == 0 )); then
        # `stop` (with any argument) and the host-side commands that only
        # read. With a container option they are not host-side, so the
        # strict path below applies.
        case "${routed_command}" in
            stop|summary|report|rehearse|ready|go|journal|diagnose|explain) routed_tolerant=1 ;;
        esac
    fi
    if (( practice != 0 || admin != 0 )); then
        printf 'SIPPYCUP_ROUTED_PRACTICE cannot be combined with --practice or --admin.\n' >&2
        printf 'Nothing was sent; no container or network activity was started. Unset SIPPYCUP_ROUTED_PRACTICE, or drop --practice.\n' >&2
        exit 2
    fi
    join_routed_practice "${SIPPYCUP_ROUTED_PRACTICE}"
    # Host-side commands (ready, go, scope) see it too.
    export SIPPYCUP_ROUTED_ADDRESS="${routed_address}"
fi

if (( advanced != 0 )); then
    unbound_notice "the -- escape hatch"
    run_container "" "$@"
fi

if (($# == 0)); then
    unbound_notice "toolbox shell"
    run_container "/bin/bash"
fi

command_name="$1"
shift
if [[ -z "${command_mode[${command_name}]+present}" ]]; then
    unknown_command "${command_name}"
fi

mode="${command_mode[${command_name}]}"
host_target="${command_host_target[${command_name}]}"
container_target="${command_container_target[${command_name}]}"
collect_secret_environment "$@"

if [[ $# == 1 && ("$1" == "-h" || "$1" == "--help") ]]; then
    case "${mode}" in
        doctor|container|container-isolated|container-offline|container-live-mcp)
            render_command_help "${command_name}"
            exit 0
            ;;
    esac
fi

case "${mode}" in
    builtin)
        case "${command_name}" in
            help)
                if (($# == 0)) || [[ $# == 1 && ("$1" == "-h" || "$1" == "--help") ]]; then
                    render_global_help
                elif (($# == 1)); then
                    render_command_help "$1"
                else
                    printf 'Usage: ./bin/sippycup help [COMMAND]\n' >&2
                    exit 2
                fi
                ;;
            commands)
                if (($# == 0)); then
                    render_commands_human
                    printf '\nNetwork activity: none\n'
                elif [[ $# == 1 && ("$1" == "-h" || "$1" == "--help") ]]; then
                    cat <<'EOF'
Usage: ./bin/sippycup commands [--format json]

List the stable public command registry without network activity.
EOF
                elif [[ $# == 2 && "$1" == "--format" && "$2" == "json" ]]; then
                    render_commands_json
                else
                    printf 'Usage: ./bin/sippycup commands [--format json]\n' >&2
                    exit 2
                fi
                ;;
            version)
                if (($# == 0)); then
                    printf 'sippycup %s\n' "${cli_version}"
                elif [[ $# == 1 && ("$1" == "-h" || "$1" == "--help") ]]; then
                    cat <<'EOF'
Usage: ./bin/sippycup version

Show the stable Sippycup CLI version without network activity.
EOF
                else
                    printf 'Usage: ./bin/sippycup version\n' >&2
                    exit 2
                fi
                ;;
        esac
        ;;
    doctor)
        if [[ "${1:-}" == "--host" ]]; then
            if (( isolated != 0 || admin != 0 || practice != 0 )); then
                printf 'doctor --host cannot be combined with container options.\n' >&2
                exit 2
            fi
            shift
            exec "${project_dir}/bin/sippycup-workbench" doctor "$@"
        fi
        if [[ "${1:-}" == "--cleanup" ]]; then
            if (( isolated != 0 || admin != 0 || practice != 0 )); then
                printf 'doctor --cleanup cannot be combined with container options.\n' >&2
                exit 2
            fi
            shift
            exec "${project_dir}/bin/sippycup-workbench" cleanup "$@"
        fi
        run_container "${container_target}" doctor "$@"
        ;;
    workbench)
        if (( isolated != 0 || admin != 0 || practice != 0 )); then
            translate_work_arguments "$@"
            run_container "${container_target}" "${host_target}" \
                "${translated_arguments[@]}"
        fi
        exec "${project_dir}/bin/sippycup-workbench" "${host_target}" "$@"
        ;;
    direct)
        # `campaign run|execute` sends to the target and captures. Like
        # call and matrix run it always runs in the image with a private
        # network namespace, where rootless capture works (finding 5: on the
        # host, tcpdump has no permission and the run failed before sending).
        if sends_from_private_container "$@"; then
            if (( admin != 0 )); then
                printf '%s %s rejects --admin; it never needs NET_ADMIN.\n' \
                    "${command_name}" "$1" >&2
                exit 2
            fi
            refuse_overlap "$@"
            isolated=1
            translate_work_arguments "$@"
            run_container "${container_target}" "${translated_arguments[@]}"
        fi
        if [[ "${command_name}" == media && "${1:-}" == send ]] \
            && ! [[ " $* " == *" -h "* || " $* " == *" --help "* ]]; then
            refuse_overlap "$@"
        fi
        # Routed, a host process would send the link-local address out of the
        # default route's interface: every direct command runs in the image,
        # whose private namespace maps it to host loopback.
        if (( isolated != 0 || admin != 0 || practice != 0 )) || [[ -n "${routed_address}" ]]; then
            translate_work_arguments "$@"
            run_container "${container_target}" "${translated_arguments[@]}"
        fi
        exec "${project_dir}/bin/${host_target}" "$@"
        ;;
    host)
        if (( isolated != 0 || admin != 0 || practice != 0 )); then
            printf '%s is host-side and cannot use container options.\n' "${command_name}" >&2
            exit 2
        fi
        if [[ -n "${routed_address}" ]]; then
            case "${command_name}" in
                go|ready|stop|report|practice-target) ;;
                *)
                    printf '%s runs on the host network and is refused while SIPPYCUP_ROUTED_PRACTICE is set:\n' \
                        "${command_name}" >&2
                    printf 'the routed address %s would leave on the default route. Nothing was sent.\n' \
                        "${routed_address}" >&2
                    exit 2
                    ;;
            esac
        fi
        exec "${project_dir}/bin/${host_target}" "$@"
        ;;
    container)
        if [[ "${command_name}" == shell ]]; then
            unbound_notice "toolbox shell"
        fi
        if [[ "${command_name}" == preflight ]]; then
            # preflight always runs in the image, so --tls-ca work/... must
            # be spelled the way the container sees it. It sends from the
            # same private network namespace as call, so both use the same
            # route and source address (without --admin, which keeps the
            # host network it always had).
            if (( admin == 0 )) && sends_from_private_container "$@"; then
                isolated=1
            fi
            if sends_from_private_container "$@"; then
                refuse_overlap "$@"
            fi
            translate_work_arguments "$@"
            run_container "${container_target}" "${translated_arguments[@]}"
        else
            run_container "${container_target}" "$@"
        fi
        ;;
    container-isolated)
        if (( practice != 0 )); then
            printf '%s has a fixed isolated network and rejects --practice.\n' \
                "${command_name}" >&2
            exit 2
        fi
        isolated=1
        run_container "${container_target}" "$@"
        ;;
    container-private)
        # Always in the image with a private network namespace, where
        # rootless capture works without sudo. Help and --dry-run need no
        # container or network, so they run from the repository.
        if (( admin != 0 )); then
            printf '%s rejects --admin; it never needs NET_ADMIN.\n' "${command_name}" >&2
            exit 2
        fi
        # checks list|explain|plan read only the catalog and the profile.
        if [[ "${command_name}" == checks && ( $# == 0 || "${1}" == list || "${1}" == explain || "${1}" == plan ) ]]; then
            exec "${project_dir}/bin/${host_target}" "$@"
        fi
        # matrix plan reads only the profiles.
        if [[ "${command_name}" == matrix && ( $# == 0 || "${1}" == plan ) ]]; then
            exec "${project_dir}/bin/${host_target}" "$@"
        fi
        for argument in "$@"; do
            if [[ "${argument}" == --dry-run || "${argument}" == -h || "${argument}" == --help ]]; then
                exec "${project_dir}/bin/${host_target}" "$@"
            fi
        done
        # call, matrix run, and checks run send; other subcommands only read.
        if [[ "${command_name}" == call || "${1:-}" == run ]]; then
            refuse_overlap "$@"
        fi
        isolated=1
        translate_work_arguments "$@"
        run_container "${container_target}" "${translated_arguments[@]}"
        ;;
    container-offline)
        if (( isolated != 0 || admin != 0 || practice != 0 )); then
            printf '%s has a fixed offline sandbox and rejects container options.\n' \
                "${command_name}" >&2
            exit 2
        fi
        offline_container=1
        run_container "${container_target}" "$@"
        ;;
    container-live-mcp)
        if (( isolated != 0 || admin != 0 || practice != 0 )); then
            printf '%s has a fixed least-privilege live sandbox and rejects container options.\n' \
                "${command_name}" >&2
            exit 2
        fi
        run_live_mcp "$@"
        ;;
esac
