#!/usr/bin/env bash
set -euo pipefail

commands=(
    age
    age-keygen
    baresip
    boo
    campaign
    campaign-sipp-runner
    campaign-softphone-runner
    campaign-softphone-selftest
    campaign-sip-challenge-stub
    campaign-loopback-uas
    campaign-integration-selftest
    call-integration-selftest
    capinfos
    dumpcap
    editcap
    ffmpeg
    gst-launch-1.0
    hping3
    iperf3
    minisign
    mergecap
    nc
    ngrep
    nmap
    nsenter
    openssl
    pasta
    pjsua
    scapy
    setpriv
    sipp
    sipvicious_svcrack
    sipvicious_svmap
    sipvicious_svreport
    sipvicious_svwar
    sippycup-preflight
    sippycup-options
    sippycup-assert
    sippycup-call
    sippycup-checks
    sippycup-matrix
    sippycup-chaos
    sippycup-diff
    sippycup-ladder
    sippycup-diagnose
    sippycup-evidence
    sippycup-pack
    sippycup-envelope
    sippycup-media
    sippycup-media-echo
    sippycup-mcp
    sippycup-mcp-live
    sippycup-torture
    sippycup-ui
    sippycup-resilience
    sippycup-workbench
    sippycup-report
    sippycup-selftest
    sngrep
    socat
    sox
    sslscan
    tc
    tcpdump
    tcpreplay
    termshark
    testssl
    text2pcap
    tshark
    turnutils_peer
    turnutils_stunclient
    turnutils_uclient
    reordercap
)

missing=0
for tool in "${commands[@]}"; do
    if ! command -v "${tool}" >/dev/null 2>&1; then
        printf 'MISSING  %s\n' "${tool}" >&2
        missing=1
    else
        printf 'ok       %s\n' "${tool}"
    fi
done

PYTHONPATH=/usr/local/lib python3 - <<'PY'
import boofuzz
import mcp
import scapy.all
import sipvicious
import yaml
import sippycup
import sippycup_chaos
import sippycup_learn
import sippycup_media
import sippycup_mcp
import sippycup_resilience
import sippycup_oracle
import sippycup_softphone
import sippycup_workbench.call
import sippycup_checks.runner
import sippycup_torture
import sippycup_tui
import sippycup_webrtc
import sippycup_workbench
print("ok       Python modules: dependencies and all first-party packages")
PY

# sipsak was replaced by the in-tree OPTIONS client (sippycup-options).
if command -v sipsak >/dev/null 2>&1; then
    printf 'UNEXPECTED sipsak is installed\n' >&2
    missing=1
fi

if (( missing != 0 )); then
    exit 1
fi

first_party_help=(
    campaign
    sippycup-options
    call-integration-selftest
    sippycup-assert
    sippycup-call
    sippycup-checks
    sippycup-matrix
    sippycup-chaos
    sippycup-diff
    sippycup-ladder
    sippycup-diagnose
    sippycup-envelope
    sippycup-evidence
    sippycup-media
    sippycup-media-echo
    sippycup-mcp
    sippycup-mcp-live
    sippycup-pack
    sippycup-torture
    sippycup-ui
    sippycup-resilience
    sippycup-workbench
)
for tool in "${first_party_help[@]}"; do
    "${tool}" --help >/dev/null
    printf 'ok       %s --help\n' "${tool}"
done

journal_parent="$(mktemp -d)"
sippycup-workbench journal init "${journal_parent}/assessment" >/dev/null
sippycup-workbench journal add "${journal_parent}/assessment" \
    --kind note --summary "container smoke journal entry" >/dev/null
sippycup-workbench journal verify "${journal_parent}/assessment" >/dev/null
printf 'ok       workbench journal lifecycle\n'
sippycup-workbench scope questions >/dev/null
sippycup-workbench scope init "${journal_parent}/assessment" >/dev/null
printf 'ok       workbench scope intake\n'

sippycup-torture exit-gate >/dev/null
printf 'ok       torture technical exit gate\n'

set +e
status_json="$(
    sippycup-workbench status "${journal_parent}/assessment" --format json
)"
status_code=$?
set -e
test "${status_code}" -eq 1
printf '%s' "${status_json}" \
    | jq -e '.networkActivity == false and .overall == "blocked"' >/dev/null
printf 'ok       offline engagement advisor\n'
sippycup-workbench summary "${journal_parent}/assessment" \
    --generated-at 2026-01-01T00:00:00Z --format json >/dev/null
jq -e '.apiVersion == "sippycup.dev/engagement-report/v1" and .networkActivity == false' \
    "${journal_parent}/assessment/report/report.json" >/dev/null
printf 'ok       workbench owner engagement report\n'

printf '\nSIPp build:\n'
set +e
sipp_version="$(sipp -v 2>&1)"
sipp_status=$?
set -e

if [[ "${sipp_status}" -ne 0 && "${sipp_status}" -ne 99 ]]; then
    printf '%s\n' "${sipp_version}" >&2
    exit "${sipp_status}"
fi

printf '%s\n' "${sipp_version}" | sed -n '1,8p'

printf '\nPJSUA build:\n'
pjsua_version="$(pjsua --version 2>&1)"
printf '%s\n' "${pjsua_version}" | sed -n '1,12p'
if ! printf '%s\n' "${pjsua_version}" | grep -q 'PJ_VERSION[[:space:]]*: 2.17'; then
    printf 'PJSUA did not report the pinned 2.17 version.\n' >&2
    exit 1
fi
if ! printf '%s\n' "${pjsua_version}" | grep -q 'PJ_HAS_IPV6[[:space:]]*: 1'; then
    printf 'PJSUA was built without required IPv6 support.\n' >&2
    exit 1
fi
if ! printf '%s\n' "${pjsua_version}" | grep -q 'PJ_HAS_SSL_SOCK[[:space:]]*: 1'; then
    printf 'PJSUA was built without required TLS support.\n' >&2
    exit 1
fi

# bn-3l8o: the media guard preloaded into PJSUA. Loopback only: an RTP-shaped
# datagram for an address outside the rules must not arrive, one inside must.
printf '\nMedia guard:\n'
guard_library="${SIPPYCUP_MEDIA_GUARD_LIBRARY:-/usr/local/lib/sippycup-media-guard.so}"
if [[ ! -f "${guard_library}" ]]; then
    printf 'The media guard library %s is missing from the image.\n' "${guard_library}" >&2
    exit 1
fi
if ! LD_PRELOAD="${guard_library}" SIPPYCUP_MEDIA_GUARD_RULES='v1;addr=127.0.0.2/32;ports=*' \
    python3 -c '
import socket, sys
def listener(address):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind((address, 0))
    sock.settimeout(0.5)
    return sock
def arrives(sock, data):
    sender = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sender.sendto(data, sock.getsockname())
    try:
        sock.recvfrom(2000)
        return True
    except socket.timeout:
        return False
inside, outside = listener("127.0.0.2"), listener("127.0.0.9")
rtp, rtcp = bytes([0x80, 0]) + bytes(170), bytes([0x81, 201]) + bytes(58)
facts = (arrives(inside, rtp), arrives(inside, rtcp), arrives(outside, rtp), arrives(outside, rtcp),
         arrives(outside, b"OPTIONS sip:smoke SIP/2.0\r\n\r\n"))
sys.exit(0 if facts == (True, True, False, False, True) else 1)
' 2>/dev/null; then
    printf 'The media guard did not drop media for an unapproved address (or dropped approved media).\n' >&2
    exit 1
fi
printf 'ok       media guard drops RTP and RTCP for an unapproved address, passes approved media and SIP\n'
