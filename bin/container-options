#!/usr/bin/env python3
"""Send one bounded SIP OPTIONS transaction; installed as sippycup-options."""

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from sippycup.options_cli import main  # noqa: E402


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("sippycup-options: interrupted", file=sys.stderr)
        raise SystemExit(130)
