#!/usr/bin/env python3
"""Run one frozen campaign step: SIPp for calls, the in-tree OPTIONS client."""

import json
import subprocess
import sys


def options_step(step: dict, address: str, port: int, transport: str) -> int:
    """One OPTIONS transaction judged by the frozen case expectations.

    ``expectations.finalStatus`` (when the case set one) must match exactly;
    otherwise a 2xx is required. UDP retransmits once only when the step's
    packet budget covers the worst case (two requests and two responses).
    """
    from pathlib import Path

    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
    from sippycup import options

    expectations = step.get("expectations") or {}
    expected = expectations.get("finalStatus")
    budget = step["budget"]
    max_requests = 2 if budget["packets"] >= 4 else 1
    timeout = min(5.0, float(budget["durationSeconds"]))
    result = options.send_options(
        address, port, transport, timeout=timeout, max_requests=max_requests
    )
    met = options.meets_expectation(result, expect_status=expected)
    summary = result.to_dict()
    summary["expectation"] = expected if expected is not None else "2xx"
    summary["met"] = met
    print(json.dumps(summary, sort_keys=True, separators=(",", ":")))
    return 0 if met else 1


def main() -> int:
    envelope = json.loads(sys.stdin.readline())
    step = envelope["step"]
    credentials = envelope.get("credentials", {})
    if credentials:
        print(
            "campaign-sipp-runner: authenticated SIP is unavailable without "
            "placing a secret in SIPp argv",
            file=sys.stderr,
        )
        return 2
    destination = step["destination"]
    address = destination["addresses"][0]
    host = f"[{address}]" if ":" in address else address
    port = destination["port"]
    transport = destination["transport"]
    timeout = f"{step['budget']['durationSeconds']}s"
    if step["type"] == "options":
        return options_step(step, address, port, transport)
    else:
        transport_flag = {"udp": "u1", "tcp": "t1", "tls": "l1"}[transport]
        command = [
            "sipp",
            f"{host}:{port}",
            "-sn",
            "uac",
            "-m",
            "1",
            "-timeout",
            timeout,
            "-nostdin",
            "-t",
            transport_flag,
        ]
    return subprocess.run(command, stdin=subprocess.DEVNULL, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
